---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  hasCode?: boolean;
  hasMath?: boolean;
}

const { title, hasCode = false, hasMath = false } = Astro.props;
---

<BaseLayout title={title}>
  {hasCode && (
    <link
      slot="head"
      href="https://lf9-cdn-tos.bytecdntp.com/cdn/expire-1-M/firacode/6.2.0/fira_code.min.css"
      type="text/css"
      rel="stylesheet"
    />
  )}
  {hasMath && (
    <link
      slot="head"
      href="https://lf9-cdn-tos.bytecdntp.com/cdn/expire-1-M/KaTeX/0.15.2/katex.min.css"
      type="text/css"
      rel="stylesheet"
    />
  )}
  <slot />
</BaseLayout>
