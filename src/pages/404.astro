---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Main from '../components/Main.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="404 - 页面未找到">
  <Header isTocButtonShow={false} />
  <Main>
    <div class="flex-1 flex flex-col items-center justify-center py-XXL">
      <h1 class="text-64 font-semibold text-NeutralForeground3 m-0">404</h1>
      <p class="text-Base-400 text-NeutralForeground3 mt-L mb-XXL">页面未找到</p>
      <a href="/" class="text-BrandForegroundLink no-underline hover:underline">返回首页</a>
    </div>
  </Main>
  <Footer />
</BaseLayout>
