---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Main from '../../components/Main.astro';
import Footer from '../../components/Footer.astro';
import Pagination from '../../components/fluent/Pagination.astro';
import { getAllPosts, getPostsGroupedByPage } from '@libs/posts';

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  const pages = getPostsGroupedByPage(allPosts);
  return pages.map((_, index) => ({
    params: { pageIndex: String(index + 1) },
  }));
}

const { pageIndex } = Astro.params;
const currentPage = Number(pageIndex);

const allPosts = await getAllPosts();
const pages = getPostsGroupedByPage(allPosts);
const metas = pages[currentPage - 1].map((post) => post.meta);
const totalPages = pages.length;
---

<BaseLayout>
  <Header isTocButtonShow={false} />
  <Main>
    <div>
      {metas.map(({ slug, title }) => (
        <div>
          <a href={`/post/${slug}`}>{title}</a>
        </div>
      ))}
    </div>
    <Pagination current={currentPage} total={totalPages} />
  </Main>
  <Footer />
</BaseLayout>
