---
interface Props {
  id: string;
  type?: 1 | 2 | 3;
  autoPlay?: boolean;
  showInfo?: boolean;
}

const { id, type = 2, autoPlay = false, showInfo = true } = Astro.props;

const src = `//music.163.com/outchain/player?type=${type}&id=${id}&auto=${autoPlay ? '1' : '0'}&height=66`;
const infoLink = `https://music.163.com/${type === 3 ? 'program' : 'song'}?id=${id}`;
---

<p>
  <iframe
    class="mx-auto w-full max-w-640px h-89px"
    src={src}
    title="网易云音乐"
  />
  {showInfo && (
    <div class="text-center text-10px">
      如因版权问题无法加载, 请跳转至
      <a
        class="text-theme"
        href={infoLink}
        target="_blank"
        rel="noreferrer"
      >
        网易云
      </a>
      播放.
    </div>
  )}
</p>
