---
interface Props {
  src?: string;
  href?: string;
  width?: number;
  height?: number;
  needDownload?: boolean;
}

const { src, href, width = 16, height = 9, needDownload = false } = Astro.props;
const pdfSrc = src || href || '';
const paddingTop = `${(100 * height) / width}%`;
const id = `pdf-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="responsive-iframe-container" style={`padding-top: ${paddingTop}`} id={id} data-pdf-src={pdfSrc} data-need-download={String(needDownload)}>
  {!needDownload ? (
    <iframe src={pdfSrc} loading="lazy" title="PDF"></iframe>
  ) : (
    <div class="flex items-center justify-center absolute inset-0 text-NeutralForeground3" data-pdf-loading>
      Loading PDF...
    </div>
  )}
</div>

{needDownload && (
  <script>
    document.querySelectorAll('[data-need-download="true"][data-pdf-src]').forEach(async (container) => {
      const src = container.getAttribute('data-pdf-src');
      if (!src) return;
      const loadingEl = container.querySelector('[data-pdf-loading]');
      try {
        const response = await fetch(src);
        const blob = await response.blob();
        const url = URL.createObjectURL(blob);
        const iframe = document.createElement('iframe');
        iframe.src = url;
        iframe.title = 'PDF';
        iframe.style.cssText = 'width:100%;height:100%;position:absolute;top:0;left:0';
        if (loadingEl) loadingEl.remove();
        container.appendChild(iframe);
      } catch (e) {
        if (loadingEl) loadingEl.textContent = 'Failed to load PDF';
      }
    });
  </script>
)}
