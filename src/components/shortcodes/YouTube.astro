---
import '@components/post/shortcodes/responsive-iframe.css';

interface Props {
  id: string;
  width?: number;
  height?: number;
  start?: number;
  showControls?: boolean;
}

const { id, width = 16, height = 9, start = 0, showControls = true } = Astro.props;

const paddingTop = `${(100 * height) / width}%`;
const src = `https://www.youtube-nocookie.com/embed/${id}?${showControls ? '' : 'controls=0'}&start=${start}`;
---

<p class="responsive-iframe-container" style={`padding-top: ${paddingTop}`}>
  <iframe
    src={src}
    allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
    loading="lazy"
    title="YouTube"
  />
</p>
