---
import '@components/fluent/Pagination/index.css';

interface Props {
  current: number;
  total: number;
}

const { current, total } = Astro.props;

function buildHref(page: number): string {
  return page === 1 ? '/' : `/posts/${page}`;
}
---

<div class="fluent-pagination">
  {current > 1 ? (
    <a href={buildHref(current - 1)} class="fluent-pagination__item inline-flex items-center justify-center">
      <span class="i-fluent:chevron-left-20-filled inline-flex w-20 h-20 m-S"></span>
    </a>
  ) : (
    <span class="fluent-pagination__item fluent-pagination__item--disabled inline-flex items-center justify-center">
      <span class="i-fluent:chevron-left-20-filled inline-flex w-20 h-20 m-S"></span>
    </span>
  )}
  {Array.from({ length: total }).map((_, index) => {
    const page = index + 1;
    const isActive = current === page;
    return isActive ? (
      <span class="fluent-pagination__item fluent-pagination__item--disabled inline-flex items-center justify-center">
        {page}
      </span>
    ) : (
      <a href={buildHref(page)} class="fluent-pagination__item inline-flex items-center justify-center">
        {page}
      </a>
    );
  })}
  {current < total ? (
    <a href={buildHref(current + 1)} class="fluent-pagination__item inline-flex items-center justify-center">
      <span class="i-fluent:chevron-right-20-filled inline-flex w-20 h-20 m-S"></span>
    </a>
  ) : (
    <span class="fluent-pagination__item fluent-pagination__item--disabled inline-flex items-center justify-center">
      <span class="i-fluent:chevron-right-20-filled inline-flex w-20 h-20 m-S"></span>
    </span>
  )}
</div>
