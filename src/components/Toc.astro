---
interface TocItem {
  depth: number;
  slug: string;
  text: string;
  children?: TocItem[];
}

interface Props {
  toc: TocItem[];
}

const { toc = [] } = Astro.props;

// Flatten the TOC tree (port of useFlattenToc)
const MAX_DEPTH = 8;

function flattenTocTree(items: TocItem[], relativeDepth = 1): Array<{ text: string; depth: number; slug: string }> {
  return items
    .map(({ text, depth, slug, children }) => [
      { text, depth, slug },
      ...(children && relativeDepth < MAX_DEPTH ? flattenTocTree(children, relativeDepth + 1) : []),
    ])
    .flat(2);
}

const flattenToc = flattenTocTree(toc);

// Compute min depth (port of useFlattenTocMinDepth)
let tocMinDepth = 100;
for (const item of flattenToc) {
  if (item.depth < tocMinDepth) {
    tocMinDepth = item.depth;
  }
  if (tocMinDepth === 1) {
    break;
  }
}
if (tocMinDepth === 100) {
  tocMinDepth = 1;
}

const TOC_BUTTON_HEIGHT = 28;
---

<nav class="relative">
  <div
    data-toc-title
    class="pl-20 text-Base-400 font-sans font-semibold bg-none hover:cursor-pointer"
  >
    目录
  </div>
  <ul data-toc-container class="mt-L pl-8 relative max-h-[70vh] overflow-y-auto overscroll-y-contain">
    <div
      data-toc-bar
      class="absolute z-2 w-3 bg-BrandStroke1 rounded-Medium"
      style="opacity: 0; height: 0px; top: 0px; left: 0; transition: all 0.2s ease;"
    />
    {flattenToc.map(({ text, depth, slug }) => (
      <li class="relative list-none">
        <button
          class="toc-button text-NeutralForeground2"
          data-toc-id={slug}
          title={text}
          style={`margin-left: ${(depth - tocMinDepth) * 1}em`}
        >
          {text}
        </button>
      </li>
    ))}
  </ul>
</nav>

<style>
  .toc-button {
    max-width: 100%;
    height: 28px;
    display: block;
    border: none;
    text-decoration: none;
    outline: none;
    user-select: none;
    font-family: var(--un-font-sans);
    vertical-align: middle;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    letter-spacing: -0.025em;
    cursor: pointer;
    transition-property: color, background;
    transition-duration: var(--duration-Fast, 100ms);
    transition-timing-function: var(--easing-EasyEase, ease);
    padding-left: var(--spacing-M, 12px);
    padding-right: var(--spacing-M, 12px);
    border-radius: var(--borderRadius-Medium, 4px);
    font-size: var(--fontSize-Base-300, 14px);
    background-color: var(--colorSubtleBackground, transparent);
  }

  .toc-button:hover {
    color: var(--colorNeutralForeground2Hover);
    background-color: var(--colorSubtleBackgroundHover);
  }

  .toc-button:hover:active {
    color: var(--colorNeutralForeground2Pressed);
    background-color: var(--colorSubtleBackgroundPressed);
  }

  .toc-button::before {
    content: "";
    position: absolute;
    z-index: 1;
    top: 50%;
    left: -8px;
    width: 3px;
    height: 100%;
    border-radius: var(--borderRadius-Medium, 4px);
    transform: translateY(-50%) scale(0);
    transition: all var(--duration-Slower, 300ms) var(--easing-EasyEase, ease);
  }

  .toc-button:hover::before {
    background-color: var(--colorBrandStroke2);
    transform: translateY(-50%) scale(1);
  }

  .toc-button::after {
    content: attr(title);
    display: block;
    height: 0;
    overflow: hidden;
    visibility: hidden;
    font-weight: 600;
  }
</style>

<script define:vars={{ TOC_BUTTON_HEIGHT }}>
  const tocTitle = document.querySelector('[data-toc-title]');
  const container = document.querySelector('[data-toc-container]');
  const bar = document.querySelector('[data-toc-bar]');
  const tocButtons = document.querySelectorAll('[data-toc-id]');

  // Click title to scroll to top
  tocTitle?.addEventListener('click', () => {
    window.scroll({ top: 0, behavior: 'smooth' });
  });

  // Click TOC item to jump
  tocButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-toc-id');
      if (!id) return;
      const el = document.getElementById(id);
      if (el) {
        window.scroll({ top: el.offsetTop - 60, behavior: 'smooth' });
      } else {
        window.location.hash = '#' + id;
      }
    });
  });

  // IntersectionObserver to track active sections
  const activeSectionSet = new Set();
  const activeTitleIdSet = new Set();

  function updateActiveState() {
    activeTitleIdSet.clear();
    activeSectionSet.forEach((section) => {
      const h = section.querySelector('h1,h2,h3,h4,h5,h6');
      if (h?.id) activeTitleIdSet.add(h.id);
    });

    // Compute active indices
    const len = tocButtons.length;
    const activeMap = new Array(len).fill(false);
    let firstActive = 0;
    let lastActive = 0;
    let activeCount = 0;

    if (activeTitleIdSet.size > 0) {
      for (let i = len - 1; i >= 0; i--) {
        const id = tocButtons[i].getAttribute('data-toc-id');
        const isActive = id && activeTitleIdSet.has(id);
        if (isActive) {
          activeMap[i] = true;
          activeCount++;
          if (i > lastActive) lastActive = i;
        } else {
          if (i + 1 < len && activeMap[i + 1]) {
            firstActive = i + 1;
            break;
          }
        }
      }
    }

    // Update button styles
    tocButtons.forEach((btn, i) => {
      if (activeMap[i]) {
        btn.classList.remove('text-NeutralForeground2');
        btn.classList.add('text-NeutralForeground2Hover', 'font-semibold');
      } else {
        btn.classList.add('text-NeutralForeground2');
        btn.classList.remove('text-NeutralForeground2Hover', 'font-semibold');
      }
    });

    // Update indicator bar
    if (bar) {
      const tipBarTop = firstActive * TOC_BUTTON_HEIGHT;
      const tipBarBottom = (lastActive + 1) * TOC_BUTTON_HEIGHT;
      const tipBarHeight = tipBarBottom - tipBarTop;
      bar.style.opacity = activeCount > 0 ? '1' : '0';
      bar.style.height = tipBarHeight + 'px';
      bar.style.top = tipBarTop + 'px';
    }

    // Auto-scroll container to keep active items visible
    if (container && activeCount > 0) {
      const tipBarTop = firstActive * TOC_BUTTON_HEIGHT;
      const tipBarBottom = (lastActive + 1) * TOC_BUTTON_HEIGHT;
      const containerScrollTop = container.scrollTop;
      const containerClientHeight = container.clientHeight;
      const isTipBarTopOutside = tipBarTop - containerScrollTop < 0;
      const isTipBarBottomOutside = tipBarBottom - containerScrollTop > containerClientHeight;

      if (!(isTipBarTopOutside && isTipBarBottomOutside)) {
        if (isTipBarTopOutside || isTipBarBottomOutside) {
          const newScrollTop = isTipBarTopOutside ? tipBarTop : tipBarBottom - containerClientHeight;
          container.scroll({ top: newScrollTop, behavior: 'smooth' });
        }
      }
    }
  }

  if (typeof IntersectionObserver !== 'undefined') {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const { isIntersecting, target } of entries) {
          if (isIntersecting) {
            activeSectionSet.add(target);
          } else {
            activeSectionSet.delete(target);
          }
        }
        updateActiveState();
      },
      { rootMargin: '-60px 0px 0px 0px' },
    );

    document.querySelectorAll('section:has(h1,h2,h3,h4,h5,h6)').forEach((section) => {
      observer.observe(section);
    });
  }
</script>
