---
import type { MetaType } from '@libs/posts';
import { formatDateTime } from '@src/utils/data';

interface Props {
  metas: MetaType[];
}

const { metas } = Astro.props;
---

<div class="flex flex-col">
  {metas.map(({ slug, title, date, tags }) => (
    <a
      href={`/post/${slug}`}
      class="block px-L py-M rounded-Medium no-underline text-NeutralForeground1 hover:bg-SubtleBackgroundHover active:bg-SubtleBackgroundPressed transition-colors duration-Fast"
    >
      <div class="text-Base-400 leading-Base-500 font-normal">{title}</div>
      <div class="mt-XS flex items-center gap-M text-Base-200 leading-Base-200 text-NeutralForeground3">
        <time datetime={date.toISOString()}>
          {formatDateTime(date, 'yyyy-MM-dd')}
        </time>
        {tags.length > 0 && (
          <div class="flex items-center gap-XS">
            <span class="i-fluent:tag-16-regular w-12 h-12" />
            <span>{tags.slice(0, 3).join(' / ')}</span>
          </div>
        )}
      </div>
    </a>
  ))}
</div>
