---
import Toc from './Toc.astro';
import Button from './fluent/Button.astro';
import { BLOG_GITHUB_REPO_HOST } from '@constants/blog';

interface Props {
  toc: Array<{ depth: number; slug: string; text: string }>;
  sourceFilePath: string;
}

const { toc, sourceFilePath } = Astro.props;
---

<aside
  data-aside
  class="
    lg:flex-0 lg:shrink-0 lg:w-280
    <lg:rounded-Medium
    <lg:glass <lg:shadow-Normal-4
    <lg:p-12px <lg:fixed <lg:top-64px <lg:bottom-10px
    <lg:right-L <sm:right-S
    <lg:hidden
  "
>
  <div class="sticky top-86 h-[calc(100vh-146px)]">
    <Toc toc={toc} />
    <div class="h-1 mx-12 my-L bg-NeutralStroke1 rounded-Medium" />
    <div>
      <a href={`${BLOG_GITHUB_REPO_HOST}/tree/master/content/${sourceFilePath}`} target="_blank" rel="noreferrer">
        <Button appearance="transparent" size="medium" iconPosition="after">
          <span slot="icon-regular" class="i-fluent:arrow-up-right-16-regular text-Base-300" />
          <span slot="icon-filled" class="i-fluent:arrow-up-right-16-filled text-Base-300" />
          在 Github 上编辑此页
        </Button>
      </a>
    </div>
    <div data-aside-back-top class="transition-opacity opacity-0">
      <Button
        data-aside-scroll-top
        appearance="transparent"
        size="medium"
        iconPosition="after"
      >
        <span slot="icon-regular" class="i-fluent:arrow-circle-up-16-regular text-Base-300" />
        <span slot="icon-filled" class="i-fluent:arrow-circle-up-16-filled text-Base-300" />
        回到顶部
      </Button>
    </div>
  </div>
</aside>

<script>
  const aside = document.querySelector('[data-aside]');
  const backTopWrapper = document.querySelector('[data-aside-back-top]');
  const backTopBtn = document.querySelector('[data-aside-scroll-top]');

  // Toggle visibility via toggle-toc event
  window.addEventListener('toggle-toc', () => {
    aside?.classList.toggle('<lg:hidden');
  });

  // Show/hide back-to-top based on scroll
  window.addEventListener('scroll', () => {
    if (backTopWrapper) {
      if (window.scrollY >= 1000) {
        backTopWrapper.classList.remove('opacity-0');
      } else {
        backTopWrapper.classList.add('opacity-0');
      }
    }
  });

  // Scroll to top
  backTopBtn?.addEventListener('click', () => {
    window.scroll({ top: 0, behavior: 'smooth' });
  });
</script>
