{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@src/*": ["./src/*"],
      "@libs/*": ["./src/libs/*"],
      "@components/*": ["./src/components/*"],
      "@constants/*": ["./src/constants/*"],
      "@styles/*": ["./src/styles/*"]
    }
  },
  "include": [
    "**/*.mjs",
    "**/*.ts",
    "**/*.tsx",
    "**/*.astro",
    "src/env.d.ts"
  ],
  "exclude": ["node_modules"]
}
